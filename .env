# The project path contains Chinese characters. PyQt5's bundled Qt 5.15.2
# cannot load platform plugins from a non-ASCII venv path, so the virtual
# environment must stay at this ASCII-only path.
# Usage: uv run --env-file .env main_MFGWind.py   (or just run.bat)
UV_PROJECT_ENVIRONMENT=C:/Users/Jason.Fan/.venvs/MFGTool_PyQt5
